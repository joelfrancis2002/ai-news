    "@types/node-cron": "^3.0.11",
    "@upstash/qstash": "^2.10.1",
    "@upstash/redis": "^1.38.0",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.16.0",
    "bullmq": "^5.76.5",
    "density-clustering": "^1.3.0",
    "dotenv": "^16.6.1",
    "ioredis": "^5.10.1",
    "node-cron": "^4.2.1",
    "rss-parser": "^3.13.0"
