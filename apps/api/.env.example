# ─── Authentication ───────────────────────────────────────────────────────────

# REQUIRED. JWT signing secret. Must be 64+ random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
AUTH_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/ainews

# ─── First Admin Bootstrap ────────────────────────────────────────────────────
# Only required when bootstrapping a fresh database with no users.
# Set ALLOW_FIRST_USER_BOOTSTRAP=true TEMPORARILY, then remove it after first login.
# NEVER set this to true in production after initial setup.
ALLOW_FIRST_USER_BOOTSTRAP=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
ADMIN_NAME=Admin

# ─── API Settings ─────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
ALLOWED_ORIGINS=http://localhost:5173
