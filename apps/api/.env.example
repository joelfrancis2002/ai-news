# Database connection string for Prisma. Required for database access.
DATABASE_URL="file:./dev.db"

# HMAC signing secret used by the custom auth token system.
# Must be long, random, and kept secret.
HMAC_SECRET="replace-with-a-strong-secret"

# Comma-separated list of allowed origins for browser clients.
# Example: http://localhost:5173,https://app.example.com
ALLOWED_ORIGINS="http://localhost:5173"

# Application mode. Determines CORS and logging behavior.
NODE_ENV="development"

# API listen port.
PORT=4000
